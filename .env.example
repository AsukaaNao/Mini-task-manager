# ==========================================
# Server & Backend Configuration
# ==========================================

# PORT: The port the Express server listens on (default: 3000)
PORT=3000

# DATABASE_PATH: Path to the JSON database file (default: ./data/tasks.json)
DATABASE_PATH="./data/tasks.json"

# CORS_ORIGIN: Allowed CORS origins (e.g. "*" or "http://localhost:5173")
CORS_ORIGIN="*"

# ==========================================
# Frontend Configuration (Vite)
# ==========================================

# VITE_API_BASE_URL: Base URL for backend REST API calls from the client.
# - If running full-stack on the same port: "/api" (or "")
# - If running a separate external backend: e.g. "http://localhost:4000/api"
VITE_API_BASE_URL="/api"

# ==========================================
# AI Studio / Cloud Run Environment
# ==========================================
# APP_URL: Injected automatically by AI Studio at runtime
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Injected automatically from user secrets if needed
GEMINI_API_KEY="MY_GEMINI_API_KEY"
